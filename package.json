{
  "name": "multi-shot-prompt-generator",
  "private": true,
  "description": "MiniMax H3 multi-shot image-to-video prompt generator (static site, no build step)",
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "screenshots": "node tests/e2e/screenshots.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "sortablejs": "1.15.6",
    "tailwindcss": "3.4.17"
  }
}
